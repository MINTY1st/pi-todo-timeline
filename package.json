{
  "name": "pi-timeline",
  "version": "0.1.0",
  "description": "Pi extension. Timed progress reports for long sessions, shown next to the todo list.",
  "private": true,
  "type": "module",
  "keywords": ["pi-package", "pi-extension"],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.6.0"
  }
}
