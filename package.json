{
  "name": "@minty1st/pi-todo-timeline",
  "version": "0.1.0",
  "description": "Pi extension. A todo list with timed progress reports, shown in panels above the editor and on an HTML page.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MINTY1st/pi-todo-timeline.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "todo",
    "timeline",
    "progress"
  ],
  "files": [
    "src",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.6.0"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
